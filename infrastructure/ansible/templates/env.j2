# Environment Configuration
# Generated by Ansible for {{ env }} environment

# Application Settings
APP_NAME={{ project_name }}
APP_ENV={{ env }}
DEBUG={{ 'true' if env == 'development' else 'false' }}

# API Service
API_HOST=0.0.0.0
API_PORT={{ api_port }}

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT={{ mlflow_port }}

# Database Configuration
POSTGRES_USER=mlflow
POSTGRES_PASSWORD={{ postgres_password | default('mlflow') }}
POSTGRES_DB=mlflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO/S3 Configuration
MINIO_ROOT_USER={{ minio_user | default('minioadmin') }}
MINIO_ROOT_PASSWORD={{ minio_password | default('minioadmin') }}
AWS_ACCESS_KEY_ID={{ minio_user | default('minioadmin') }}
AWS_SECRET_ACCESS_KEY={{ minio_password | default('minioadmin') }}
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# Locust Configuration
LOCUST_PORT={{ locust_port | default(8089) }}
